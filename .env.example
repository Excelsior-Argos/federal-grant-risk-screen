# Copy this file to .env and fill in the real values. .env is never committed.

# Free key from https://api.data.gov/signup
FAC_API_KEY=

# Neon Postgres connection string
DATABASE_URL=

# Optional. Claude API key from https://console.anthropic.com. Leave empty to draft through
# Claude Code on this machine instead (run `claude auth login` once).
ANTHROPIC_API_KEY=
